rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function path(value) { return /databases/$(database)/documents/$(value); }
    function bootstrapPath() { return path('system/bootstrap'); }
    function settingsPath() { return path('systemSettings/main'); }
    function userPath(uid) { return path('users/' + uid); }
    function staffProfilePath(uid) { return path('staffProfiles/' + uid); }
    function staffPermissionPath(uid) { return path('staffPermissions/' + uid); }
    function bootstrapComplete() { return exists(bootstrapPath()) && get(bootstrapPath()).data.status == 'complete'; }
    function ownerUid() { return get(bootstrapPath()).data.ownerUid; }
    function isOwner() { return signedIn() && bootstrapComplete() && request.auth.uid == ownerUid(); }
    function isInitialBootstrap() { return signedIn() && !exists(bootstrapPath()) && getAfter(bootstrapPath()).data.status == 'complete' && getAfter(bootstrapPath()).data.locked == true && getAfter(bootstrapPath()).data.ownerUid == request.auth.uid; }
    function hasPermission(values) { return signedIn() && exists(staffPermissionPath(request.auth.uid)) && get(staffPermissionPath(request.auth.uid)).data.permissions.hasAny(values); }
    function isStaff() { return isOwner() || (signedIn() && exists(staffProfilePath(request.auth.uid)) && get(staffProfilePath(request.auth.uid)).data.staffStatus != 'terminated'); }
    function isStaffManager() { return isOwner() || hasPermission(['staff.manage', 'owner.override_all']); }
    function isAcademyManager() { return isOwner() || hasPermission(['training.manage', 'academy.manage', 'staff.manage', 'owner.override_all']); }
    function isLendingStaff() { return isOwner() || hasPermission(['applications.view', 'applications.review', 'applications.claim', 'applications.approve', 'applications.deny', 'owner.override_all']); }
    function isServicingStaff() { return isOwner() || hasPermission(['loans.view', 'loans.modify', 'collections.manage', 'owner.override_all']); }
    function isEconomyManager() { return isOwner() || hasPermission(['business.manage', 'property.manage', 'investments.manage', 'insurance.manage', 'owner.override_all']); }
    function registrationOpen() { return bootstrapComplete() && exists(settingsPath()) && get(settingsPath()).data.registrationEnabled == true; }
    function ownCustomerId() { return get(userPath(request.auth.uid)).data.customerId; }
    function owns(data) { return signedIn() && data.ownerUid == request.auth.uid; }
    function assignedTo(data) { return signedIn() && data.staffUid == request.auth.uid; }
    function immutableCreate() { return request.resource.data.immutable == true; }

    match /system/bootstrap { allow read: if true; allow create: if isInitialBootstrap(); allow update, delete: if false; }
    match /systemSettings/main { allow read: if true; allow create: if isInitialBootstrap() || isOwner(); allow update, delete: if isOwner(); }

    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && uid == request.auth.uid);
      allow create: if isInitialBootstrap() || isOwner() || (registrationOpen() && signedIn() && uid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.primaryRole == 'customer' && request.resource.data.accountStatus == 'active');
      allow update: if isOwner() || (signedIn() && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'discordUsername', 'updatedAt']));
      allow delete: if isOwner() && uid != ownerUid();
    }

    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isInitialBootstrap() || isOwner() || (registrationOpen() && signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.authEmail == request.auth.token.email);
      allow update: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid);
      allow delete: if isOwner();
    }

    match /customerProfiles/{uid} {
      allow read: if isOwner() || (signedIn() && uid == request.auth.uid);
      allow create: if isInitialBootstrap() || isOwner() || (registrationOpen() && signedIn() && uid == request.auth.uid && request.resource.data.uid == request.auth.uid);
      allow update: if isOwner() || (signedIn() && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'discordUsername', 'profileCompletion', 'publicVerificationEnabled']));
      allow delete: if isOwner();
    }
    match /customerPrivate/{uid} {
      allow read: if isOwner() || (signedIn() && uid == request.auth.uid);
      allow create: if isInitialBootstrap() || isOwner() || (registrationOpen() && signedIn() && uid == request.auth.uid && request.resource.data.uid == request.auth.uid);
      allow update: if isOwner() || (signedIn() && uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.customerId == resource.data.customerId);
      allow delete: if isOwner();
    }

    match /accounts/{id} {
      allow read: if isOwner() || owns(resource.data) || isServicingStaff() || isEconomyManager();
      allow create: if isInitialBootstrap() || isOwner() || (registrationOpen() && signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.customerId == getAfter(userPath(request.auth.uid)).data.customerId && request.resource.data.type in ['checking', 'savings'] && request.resource.data.balance >= 0 && request.resource.data.availableBalance == request.resource.data.balance);
      allow update: if isOwner() || isServicingStaff() || isEconomyManager() || (owns(resource.data) && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.customerId == resource.data.customerId && request.resource.data.type == resource.data.type && request.resource.data.status == resource.data.status && request.resource.data.balance >= 0 && request.resource.data.availableBalance >= 0 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'availableBalance', 'lastOperationId', 'updatedAt']));
      allow delete: if isOwner();
    }
    match /transactions/{id} {
      allow read: if isOwner() || owns(resource.data) || isServicingStaff() || isEconomyManager();
      allow create: if isInitialBootstrap() || isOwner() || (signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.amount >= 0 && request.resource.data.status == 'completed');
      allow update, delete: if isOwner();
    }
    match /bankingOperations/{id} {
      allow read: if isOwner() || owns(resource.data);
      allow create: if isOwner() || (signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.amount > 0 && request.resource.data.status == 'completed' && immutableCreate());
      allow update, delete: if false;
    }

    match /creditProfiles/{uid} { allow read: if isOwner() || isLendingStaff() || (signedIn() && uid == request.auth.uid); allow create: if isInitialBootstrap() || isOwner() || (registrationOpen() && signedIn() && uid == request.auth.uid); allow update, delete: if isOwner(); }
    match /academyProfiles/{uid} { allow read: if isOwner() || isAcademyManager() || (signedIn() && uid == request.auth.uid); allow create: if isInitialBootstrap() || isOwner() || (registrationOpen() && signedIn() && uid == request.auth.uid); allow update: if isOwner() || isAcademyManager() || (signedIn() && uid == request.auth.uid); allow delete: if isOwner(); }
    match /achievementProfiles/{uid} { allow read: if isOwner() || (signedIn() && uid == request.auth.uid); allow create: if isInitialBootstrap() || isOwner() || (registrationOpen() && signedIn() && uid == request.auth.uid); allow update, delete: if isOwner(); }
    match /notifications/{id} { allow read: if isOwner() || (signedIn() && resource.data.recipientUid == request.auth.uid); allow create: if isInitialBootstrap() || isOwner() || isStaff() || (registrationOpen() && signedIn() && request.resource.data.recipientUid == request.auth.uid); allow update: if signedIn() && resource.data.recipientUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']); allow delete: if isOwner(); }

    match /applications/{id} {
      allow read: if isOwner() || isLendingStaff() || isStaffManager() || (signedIn() && resource.data.applicantUid == request.auth.uid);
      allow create: if isOwner() || (signedIn() && request.resource.data.applicantUid == request.auth.uid && request.resource.data.customerId == ownCustomerId() && request.resource.data.uploadsAllowed == false && request.resource.data.status == 'draft');
      allow update: if isOwner() || isLendingStaff() || isStaffManager() || (signedIn() && resource.data.applicantUid == request.auth.uid && request.resource.data.applicantUid == resource.data.applicantUid && request.resource.data.customerId == resource.data.customerId && request.resource.data.status in ['draft', 'submitted', 'withdrawn', 'accepted', 'offer-declined']);
      allow delete: if isOwner() || (signedIn() && resource.data.applicantUid == request.auth.uid && resource.data.status == 'draft');
    }
    match /lendingDecisions/{id} { allow read: if isLendingStaff() || (signedIn() && resource.data.applicantUid == request.auth.uid); allow create: if isLendingStaff() && immutableCreate(); allow update, delete: if false; }

    match /loans/{id} {
      allow read: if isServicingStaff() || isOwner() || owns(resource.data);
      allow create: if isOwner() || (signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'pending-activation');
      allow update: if isOwner() || isServicingStaff() || (owns(resource.data) && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.loanId == resource.data.loanId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingPrincipal', 'totalPaid', 'paymentsRemaining', 'nextDueDate', 'status', 'servicingStatus', 'delinquencyStage', 'lastPaymentAt', 'lastOperationId', 'assistanceRequest', 'updatedAt']));
      allow delete: if isOwner();
    }
    match /loanOperations/{id} { allow read: if isServicingStaff() || isOwner() || owns(resource.data); allow create: if isOwner() || (signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.amount > 0 && immutableCreate()); allow update, delete: if false; }
    match /loanPayments/{id} { allow read: if isServicingStaff() || isOwner() || owns(resource.data); allow create: if isOwner() || (signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.amount > 0 && request.resource.data.status == 'completed'); allow update, delete: if false; }
    match /loanEvents/{id} { allow read: if isServicingStaff() || isOwner() || owns(resource.data); allow create: if isServicingStaff() && immutableCreate(); allow update, delete: if false; }

    match /branches/{id} { allow read: if signedIn(); allow create: if isInitialBootstrap() || isOwner(); allow update, delete: if isOwner(); }
    match /departments/{id} { allow read: if signedIn(); allow create: if isInitialBootstrap() || isOwner(); allow update, delete: if isOwner(); }
    match /ranks/{id} { allow read: if signedIn(); allow create: if isInitialBootstrap() || isOwner(); allow update, delete: if isOwner(); }
    match /staffProfiles/{uid} { allow read: if isStaff(); allow create: if isInitialBootstrap() || isOwner(); allow update, delete: if isOwner(); }
    match /staffPermissions/{uid} { allow read: if isOwner() || isStaffManager() || (signedIn() && uid == request.auth.uid); allow create: if isInitialBootstrap() || isOwner(); allow update: if (isOwner() || isStaffManager()) && uid != ownerUid(); allow delete: if isOwner() && uid != ownerUid(); }
    match /staffAppointments/{id} { allow read: if isOwner() || (signedIn() && resource.data.staffUid == request.auth.uid); allow create: if isOwner() && immutableCreate(); allow update, delete: if false; }
    match /staffTasks/{id} { allow read: if isStaff() && (resource.data.assigneeUid == request.auth.uid || isStaffManager()); allow create: if isStaffManager() && request.resource.data.assignedBy == request.auth.uid && request.resource.data.status == 'assigned'; allow update: if isStaffManager() || (signedIn() && resource.data.assigneeUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt']) && request.resource.data.status == 'completed'); allow delete: if isOwner(); }
    match /policies/{id} { allow read: if isStaff(); allow create: if isStaffManager() && request.resource.data.createdBy == request.auth.uid; allow update, delete: if isOwner(); }
    match /staffAnnouncements/{id} { allow read: if isStaff(); allow create: if isStaffManager() && request.resource.data.createdBy == request.auth.uid; allow update, delete: if isOwner(); }

    match /trainingAssignments/{id} { allow read: if isOwner() || isAcademyManager() || (signedIn() && resource.data.staffUid == request.auth.uid); allow create, update: if isAcademyManager(); allow delete: if isOwner(); }
    match /academyCourses/{id} { allow read: if signedIn(); allow create, update: if isAcademyManager(); allow delete: if isOwner(); }
    match /academyEnrollments/{id} { allow read: if isAcademyManager() || (signedIn() && resource.data.userUid == request.auth.uid); allow create: if signedIn() && request.resource.data.userUid == request.auth.uid; allow update: if isAcademyManager() || (signedIn() && resource.data.userUid == request.auth.uid && request.resource.data.userUid == resource.data.userUid); allow delete: if isOwner(); }
    match /academyCertificates/{id} { allow read: if isAcademyManager() || (signedIn() && resource.data.holderUid == request.auth.uid); allow create: if isAcademyManager() || (signedIn() && request.resource.data.holderUid == request.auth.uid && immutableCreate()); allow update, delete: if false; }

    match /performanceReviews/{id} { allow read: if isOwner() || isStaffManager() || assignedTo(resource.data); allow create: if isStaffManager() && request.resource.data.reviewedBy == request.auth.uid && immutableCreate(); allow update, delete: if false; }
    match /careerRequests/{id} { allow read: if isOwner() || isStaffManager() || assignedTo(resource.data); allow create: if isStaff() && request.resource.data.staffUid == request.auth.uid && request.resource.data.status == 'submitted'; allow update: if isStaffManager() && resource.data.status == 'submitted' && request.resource.data.status in ['approved', 'denied']; allow delete: if isOwner(); }
    match /careerEvents/{id} { allow read: if isOwner() || isStaffManager() || assignedTo(resource.data); allow create: if isStaffManager() && immutableCreate(); allow update, delete: if false; }

    match /businesses/{id} { allow read: if isEconomyManager() || owns(resource.data); allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.customerId == ownCustomerId() && request.resource.data.status == 'active' && request.resource.data.level == 'startup' && request.resource.data.cashReserves >= 0 && request.resource.data.cashReserves <= 100000; allow update: if isEconomyManager() || (owns(resource.data) && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.customerId == resource.data.customerId && request.resource.data.businessId == resource.data.businessId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revenue', 'expenses', 'cashReserves', 'employeeCount', 'updatedAt'])); allow delete: if isOwner(); }
    match /businessTransactions/{id} { allow read: if isEconomyManager() || owns(resource.data); allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.amount > 0 && request.resource.data.amount <= 100000 && request.resource.data.type in ['revenue', 'expense'] && immutableCreate(); allow update, delete: if false; }
    match /properties/{id} { allow read: if isEconomyManager() || owns(resource.data); allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.customerId == ownCustomerId() && request.resource.data.status == 'owned' && request.resource.data.purchasePrice > 0 && request.resource.data.purchasePrice <= 100000000; allow update: if isEconomyManager(); allow delete: if isOwner(); }
    match /investments/{id} { allow read: if isEconomyManager() || owns(resource.data); allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.customerId == ownCustomerId() && request.resource.data.principal > 0 && request.resource.data.principal <= 1000000 && request.resource.data.currentValue == request.resource.data.principal && request.resource.data.status == 'active'; allow update: if isEconomyManager(); allow delete: if isOwner(); }
    match /investmentOperations/{id} { allow read: if isEconomyManager() || owns(resource.data); allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.customerId == ownCustomerId() && request.resource.data.type == 'investment-purchase' && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000 && request.resource.data.status == 'completed' && immutableCreate(); allow update, delete: if false; }
    match /insurancePolicies/{id} { allow read: if isEconomyManager() || owns(resource.data); allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.customerId == ownCustomerId() && request.resource.data.coverageLimit > 0 && request.resource.data.premium >= 0 && request.resource.data.status == 'active'; allow update: if isEconomyManager(); allow delete: if isOwner(); }
    match /insuranceClaims/{id} { allow read: if isEconomyManager() || owns(resource.data); allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.customerId == ownCustomerId() && request.resource.data.status == 'submitted' && request.resource.data.uploadsAllowed == false && request.resource.data.requestedAmount > 0; allow update: if isEconomyManager(); allow delete: if isOwner(); }

    match /economicSettings/{id} { allow read: if signedIn(); allow create, update, delete: if isOwner(); }
    match /institutionEvents/{id} { allow read: if signedIn(); allow create, update, delete: if isOwner(); }
    match /achievements/{id} { allow read: if signedIn(); allow create, update, delete: if isOwner(); }
    match /ownerOverrides/{id} { allow read: if isOwner(); allow create: if isOwner() && request.resource.data.actorUid == request.auth.uid && immutableCreate() && request.resource.data.reason is string && request.resource.data.reason.size() >= 10; allow update, delete: if false; }
    match /auditLogs/{id} { allow read: if isOwner() || hasPermission(['audit.view', 'audit.manage']); allow create: if isInitialBootstrap() || isOwner() || isStaff() || (registrationOpen() && signedIn() && request.resource.data.actorUid == request.auth.uid && immutableCreate()); allow update, delete: if false; }

    match /{document=**} { allow read, write: if isOwner(); }
  }
}
