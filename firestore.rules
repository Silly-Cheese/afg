rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function p(path){return /databases/$(database)/documents/$(path);}
  function bootstrap(){return p('system/bootstrap');}
  function settings(){return p('systemSettings/main');}
  function user(uid){return p('users/'+uid);}
  function account(id){return p('accounts/'+id);}
  function operation(id){return p('bankingOperations/'+id);}
  function loanOperation(id){return p('loanOperations/'+id);}
  function loan(id){return p('loans/'+id);}
  function application(id){return p('applications/'+id);}
  function staffProfile(uid){return p('staffProfiles/'+uid);}
  function staffPermission(uid){return p('staffPermissions/'+uid);}
  function bootstrapComplete(){return exists(bootstrap())&&get(bootstrap()).data.status=='complete';}
  function ownerUid(){return get(bootstrap()).data.ownerUid;}
  function isOwner(){return signedIn()&&bootstrapComplete()&&request.auth.uid==ownerUid();}
  function hasStaffPermission(values){return signedIn()&&exists(staffPermission(request.auth.uid))&&get(staffPermission(request.auth.uid)).data.permissions.hasAny(values);}
  function isStaff(){return isOwner()||(signedIn()&&exists(staffProfile(request.auth.uid))&&get(staffProfile(request.auth.uid)).data.staffStatus!='terminated');}
  function isStaffManager(){return isOwner()||hasStaffPermission(['staff.manage','owner.override_all']);}
  function isAcademyManager(){return isOwner()||hasStaffPermission(['training.manage','academy.manage','staff.manage','owner.override_all']);}
  function isLendingStaff(){return isOwner()||hasStaffPermission(['applications.view','applications.review','applications.claim','applications.approve','applications.deny','owner.override_all']);}
  function isServicingStaff(){return isOwner()||hasStaffPermission(['loans.view','loans.modify','collections.manage','owner.override_all']);}
  function registrationOpen(){return bootstrapComplete()&&exists(settings())&&get(settings()).data.registrationEnabled==true;}
  function isInitialBootstrap(){return signedIn()&&!exists(bootstrap())&&getAfter(bootstrap()).data.status=='complete'&&getAfter(bootstrap()).data.locked==true&&getAfter(bootstrap()).data.ownerUid==request.auth.uid;}
  function ownCustomerCreatedAfter(){return getAfter(user(request.auth.uid)).data.uid==request.auth.uid&&getAfter(user(request.auth.uid)).data.primaryRole=='customer'&&getAfter(user(request.auth.uid)).data.roles==['customer']&&getAfter(user(request.auth.uid)).data.accountStatus=='active';}
  function newCustomerBatch(){return registrationOpen()&&signedIn()&&!exists(user(request.auth.uid))&&ownCustomerCreatedAfter();}
  function validCustomerId(id){return id==getAfter(user(request.auth.uid)).data.customerId;}
  function validApplicationType(v){return v in ['personal-loan','emergency-loan','vehicle-financing','mortgage','student-loan','business-startup','business-financing','equipment-loan','commercial-property','debt-consolidation','staff-application'];}
  function customerApplicationFields(){return ['applicationId','applicantUid','customerId','applicationType','applicationName','category','status','currentStep','responses','applicantMessages','timeline','assignedReviewerUid','internalNotesCount','uploadsAllowed','createdAt','updatedAt','submittedAt','withdrawnAt'];}
  function validAccountUpdate(id){let op=getAfter(operation(request.resource.data.lastOperationId)).data;let lop=getAfter(loanOperation(request.resource.data.lastOperationId)).data;return signedIn()&&resource.data.ownerUid==request.auth.uid&&request.resource.data.ownerUid==resource.data.ownerUid&&request.resource.data.customerId==resource.data.customerId&&request.resource.data.type==resource.data.type&&request.resource.data.productName==resource.data.productName&&request.resource.data.status==resource.data.status&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance','availableBalance','lastOperationId','updatedAt'])&&((!exists(operation(request.resource.data.lastOperationId))&&op.ownerUid==request.auth.uid&&((op.type=='fictional_income'&&op.accountId==id&&request.resource.data.balance==resource.data.balance+op.amount&&request.resource.data.availableBalance==resource.data.availableBalance+op.amount)||(op.type=='internal_transfer'&&op.fromAccountId==id&&request.resource.data.balance==resource.data.balance-op.amount&&request.resource.data.availableBalance==resource.data.availableBalance-op.amount)||(op.type=='internal_transfer'&&op.toAccountId==id&&request.resource.data.balance==resource.data.balance+op.amount&&request.resource.data.availableBalance==resource.data.availableBalance+op.amount)))||(!exists(loanOperation(request.resource.data.lastOperationId))&&lop.ownerUid==request.auth.uid&&lop.type=='loan-payment'&&lop.accountId==id&&request.resource.data.balance==resource.data.balance-lop.amount&&request.resource.data.availableBalance==resource.data.availableBalance-lop.amount));}
  function validIncome(){let a=get(account(request.resource.data.accountId)).data;let z=getAfter(account(request.resource.data.accountId)).data;return request.resource.data.ownerUid==request.auth.uid&&validCustomerId(request.resource.data.customerId)&&request.resource.data.type=='fictional_income'&&request.resource.data.amount>0&&request.resource.data.amount<=100000&&request.resource.data.status=='completed'&&request.resource.data.immutable==true&&a.ownerUid==request.auth.uid&&z.lastOperationId==request.resource.data.operationId&&z.balance==a.balance+request.resource.data.amount;}
  function validTransfer(){let f=get(account(request.resource.data.fromAccountId)).data;let t=get(account(request.resource.data.toAccountId)).data;let af=getAfter(account(request.resource.data.fromAccountId)).data;let at=getAfter(account(request.resource.data.toAccountId)).data;return request.resource.data.ownerUid==request.auth.uid&&validCustomerId(request.resource.data.customerId)&&request.resource.data.type=='internal_transfer'&&request.resource.data.fromAccountId!=request.resource.data.toAccountId&&request.resource.data.amount>0&&request.resource.data.status=='completed'&&request.resource.data.immutable==true&&f.ownerUid==request.auth.uid&&t.ownerUid==request.auth.uid&&f.availableBalance>=request.resource.data.amount&&af.lastOperationId==request.resource.data.operationId&&at.lastOperationId==request.resource.data.operationId;}
  function validLoanPaymentOperation(id){let l=get(loan(request.resource.data.loanDocId)).data;let a=get(account(request.resource.data.accountId)).data;let al=getAfter(loan(request.resource.data.loanDocId)).data;let aa=getAfter(account(request.resource.data.accountId)).data;return signedIn()&&!exists(loanOperation(id))&&request.resource.data.operationId==id&&request.resource.data.type=='loan-payment'&&request.resource.data.ownerUid==request.auth.uid&&request.resource.data.amount>0&&request.resource.data.immutable==true&&request.resource.data.status=='completed'&&l.ownerUid==request.auth.uid&&a.ownerUid==request.auth.uid&&a.availableBalance>=request.resource.data.amount&&aa.lastOperationId==id&&al.lastOperationId==id;}
  function validCustomerLoanUpdate(id){let op=getAfter(loanOperation(request.resource.data.lastOperationId)).data;return signedIn()&&resource.data.ownerUid==request.auth.uid&&request.resource.data.ownerUid==resource.data.ownerUid&&request.resource.data.loanId==resource.data.loanId&&((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingPrincipal','totalPaid','paymentsRemaining','nextDueDate','status','servicingStatus','delinquencyStage','lastPaymentAt','lastOperationId','updatedAt'])&&!exists(loanOperation(request.resource.data.lastOperationId))&&op.ownerUid==request.auth.uid&&op.loanDocId==id)||(request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assistanceRequest','updatedAt'])&&request.resource.data.assistanceRequest.requestedBy==request.auth.uid&&request.resource.data.assistanceRequest.status=='pending'));}

  match /system/bootstrap{allow read:if true;allow create:if isInitialBootstrap();allow update,delete:if false;}
  match /systemSettings/main{allow read:if true;allow create:if isInitialBootstrap()||isOwner();allow update,delete:if isOwner();}
  match /users/{uid}{allow read:if isOwner()||(signedIn()&&uid==request.auth.uid);allow create:if isOwner()||(registrationOpen()&&signedIn()&&uid==request.auth.uid&&!exists(user(uid))&&request.resource.data.primaryRole=='customer'&&request.resource.data.roles==['customer']);allow update,delete:if isOwner();}
  match /usernames/{id}{allow read:if signedIn();allow create:if isOwner()||(newCustomerBatch()&&request.resource.data.uid==request.auth.uid);allow update,delete:if isOwner();}
  match /customerProfiles/{uid}{allow read:if isOwner()||(signedIn()&&uid==request.auth.uid);allow create:if isOwner()||(newCustomerBatch()&&uid==request.auth.uid);allow update,delete:if isOwner();}
  match /customerPrivate/{uid}{allow read:if isOwner()||(signedIn()&&uid==request.auth.uid);allow create:if isOwner()||(newCustomerBatch()&&uid==request.auth.uid);allow update,delete:if isOwner();}
  match /accounts/{id}{allow read:if isOwner()||(signedIn()&&resource.data.ownerUid==request.auth.uid);allow create:if isOwner()||(newCustomerBatch()&&request.resource.data.ownerUid==request.auth.uid&&request.resource.data.status=='active');allow update:if isOwner()||validAccountUpdate(id);allow delete:if isOwner();}
  match /bankingOperations/{id}{allow read:if isOwner()||(signedIn()&&resource.data.ownerUid==request.auth.uid);allow create:if isOwner()||(signedIn()&&!exists(operation(id))&&(validIncome()||validTransfer()));allow update,delete:if false;}
  match /loanOperations/{id}{allow read:if isServicingStaff()||(signedIn()&&resource.data.ownerUid==request.auth.uid);allow create:if isOwner()||validLoanPaymentOperation(id);allow update,delete:if false;}
  match /transactions/{id}{allow read:if isOwner()||(signedIn()&&resource.data.ownerUid==request.auth.uid);allow create:if isOwner()||newCustomerBatch()||(signedIn()&&request.resource.data.ownerUid==request.auth.uid);allow update,delete:if isOwner();}
  match /applications/{id}{allow read:if isLendingStaff()||(signedIn()&&resource.data.applicantUid==request.auth.uid);allow create:if isOwner()||(signedIn()&&request.resource.data.applicantUid==request.auth.uid&&validApplicationType(request.resource.data.applicationType)&&request.resource.data.status=='draft'&&request.resource.data.uploadsAllowed==false&&request.resource.data.keys().hasOnly(customerApplicationFields()));allow update:if isOwner()||(isLendingStaff()&&resource.data.category=='financial')||(signedIn()&&resource.data.applicantUid==request.auth.uid&&request.resource.data.applicantUid==resource.data.applicantUid&&request.resource.data.customerId==resource.data.customerId&&((request.resource.data.keys().hasOnly(customerApplicationFields())&&((resource.data.status=='draft'&&request.resource.data.status in ['draft','submitted','withdrawn'])||(resource.data.status=='information-requested'&&request.resource.data.status in ['information-requested','submitted','withdrawn'])||(resource.data.status in ['submitted','initial-review','assigned','department-review','final-review']&&request.resource.data.status=='withdrawn')))||(resource.data.status=='approved'&&request.resource.data.status in ['accepted','offer-declined'])));allow delete:if isOwner()||(signedIn()&&resource.data.applicantUid==request.auth.uid&&resource.data.status=='draft');}
  match /lendingDecisions/{id}{allow read:if isLendingStaff()||(signedIn()&&resource.data.applicantUid==request.auth.uid);allow create:if isLendingStaff()&&request.resource.data.immutable==true;allow update,delete:if false;}
  match /loans/{id}{allow read:if isServicingStaff()||(signedIn()&&resource.data.ownerUid==request.auth.uid);allow create:if isOwner()||(signedIn()&&request.resource.data.ownerUid==request.auth.uid&&getAfter(application(request.resource.data.applicationDocId)).data.status=='accepted');allow update:if isServicingStaff()||validCustomerLoanUpdate(id);allow delete:if isOwner();}
  match /loanPayments/{id}{allow read:if isServicingStaff()||(signedIn()&&resource.data.ownerUid==request.auth.uid);allow create:if isOwner()||(signedIn()&&request.resource.data.ownerUid==request.auth.uid);allow update,delete:if false;}
  match /loanEvents/{id}{allow read:if isServicingStaff()||(signedIn()&&resource.data.ownerUid==request.auth.uid);allow create:if isServicingStaff()&&request.resource.data.immutable==true;allow update,delete:if false;}
  match /creditProfiles/{uid}{allow read:if isOwner()||(signedIn()&&uid==request.auth.uid);allow create:if isOwner()||newCustomerBatch();allow update,delete:if isOwner();}
  match /academyProfiles/{uid}{allow read:if isOwner()||(signedIn()&&uid==request.auth.uid);allow create:if isOwner()||newCustomerBatch()||(signedIn()&&uid==request.auth.uid);allow update:if isOwner()||(signedIn()&&uid==request.auth.uid&&request.resource.data.uid==uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp','level','completedCourses','updatedAt']));allow delete:if isOwner();}
  match /achievementProfiles/{uid}{allow read:if isOwner()||(signedIn()&&uid==request.auth.uid);allow create:if isOwner()||newCustomerBatch();allow update,delete:if isOwner();}
  match /academyCourses/{id}{allow read:if signedIn();allow create,update,delete:if isAcademyManager();}
  match /academyEnrollments/{id}{allow read:if isOwner()||(signedIn()&&resource.data.userUid==request.auth.uid)||isAcademyManager();allow create:if signedIn()&&request.resource.data.userUid==request.auth.uid;allow update:if signedIn()&&resource.data.userUid==request.auth.uid&&request.resource.data.userUid==resource.data.userUid&&request.resource.data.courseId==resource.data.courseId;allow delete:if isOwner();}
  match /academyCertificates/{id}{allow read:if isOwner()||(signedIn()&&resource.data.userUid==request.auth.uid)||isAcademyManager();allow create:if signedIn()&&request.resource.data.userUid==request.auth.uid&&request.resource.data.immutable==true;allow update,delete:if false;}
  match /notifications/{id}{allow read:if isOwner()||(signedIn()&&resource.data.recipientUid==request.auth.uid);allow create:if isOwner()||newCustomerBatch();allow update,delete:if isOwner();}
  match /auditLogs/{id}{allow read:if isOwner();allow create:if isOwner()||isInitialBootstrap()||isLendingStaff()||isServicingStaff()||isStaffManager()||isAcademyManager()||newCustomerBatch();allow update,delete:if false;}
  match /branches/{id}{allow read:if signedIn();allow create:if isInitialBootstrap()||isOwner();allow update,delete:if isOwner();}
  match /departments/{id}{allow read:if signedIn();allow create:if isInitialBootstrap()||isOwner();allow update,delete:if isOwner();}
  match /ranks/{id}{allow read:if signedIn();allow create:if isInitialBootstrap()||isOwner();allow update,delete:if isOwner();}
  match /staffProfiles/{uid}{allow read:if isStaff();allow create:if isOwner()||isInitialBootstrap();allow update,delete:if isOwner();}
  match /staffPermissions/{uid}{allow read:if isOwner()||(signedIn()&&uid==request.auth.uid)||isStaffManager();allow create:if isOwner()||isInitialBootstrap();allow update:if isStaffManager()&&uid!=ownerUid();allow delete:if isOwner()&&uid!=ownerUid();}
  match /trainingAssignments/{id}{allow read:if isOwner()||(signedIn()&&resource.data.staffUid==request.auth.uid)||isAcademyManager();allow create,update,delete:if isAcademyManager();}
  match /staffAppointments/{id}{allow read:if isOwner()||(signedIn()&&resource.data.staffUid==request.auth.uid);allow create:if isOwner()&&request.resource.data.immutable==true;allow update,delete:if false;}
  match /staffTasks/{id}{allow read:if isStaff()&&(resource.data.assigneeUid==request.auth.uid||isStaffManager());allow create:if isStaffManager()&&request.resource.data.assignedBy==request.auth.uid;allow update:if signedIn()&&resource.data.assigneeUid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt','updatedAt'])&&request.resource.data.status=='completed';allow delete:if isOwner();}
  match /policies/{id}{allow read:if isStaff();allow create:if isStaffManager();allow update,delete:if isOwner();}
  match /staffAnnouncements/{id}{allow read:if isStaff();allow create:if isStaffManager();allow update,delete:if isOwner();}
  match /{document=**}{allow create:if isInitialBootstrap()||isOwner();allow read,update,delete:if isOwner();}
 }
}